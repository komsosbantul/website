NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Search Console Site Verification
# Dapatkan dari: https://search.google.com/search-console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_site_verification_code

# ==============================================================================
# Cloudflare R2 Object Storage (Zero Egress / Gratis Bandwidth Egress)
# ==============================================================================
# 1. R2_ACCOUNT_ID: Didapat dari dashboard Cloudflare (Overview R2 -> Account ID di sidebar kanan)
R2_ACCOUNT_ID=your_cloudflare_account_id

# 2. R2_ACCESS_KEY_ID & R2_SECRET_ACCESS_KEY:
#    Dibuat melalui Cloudflare R2 -> "Manage R2 API Tokens" -> "Create API token"
#    (Pilih izin "Object Read & Write")
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# 3. R2_BUCKET_NAME: Nama bucket R2 yang telah dibuat (contoh: komsos-bantul-media)
R2_BUCKET_NAME=your_r2_bucket_name

# 4. NEXT_PUBLIC_R2_PUBLIC_URL: Domain publik bucket untuk mengakses gambar
#    Bisa menggunakan subdomain R2.dev publik (misal: https://pub-xxxxxxxx.r2.dev)
#    atau custom domain terhubung (misal: https://media.parokibantul.org)
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
